{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webvibe policy",
  "type": "object",
  "required": ["version", "tools"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": 2 },
    "profile": { "type": "string" },
    "mode": { "enum": ["read-only", "dev"] },
    "extends": { "type": "string" },
    "workspace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "root": { "type": "string" },
        "protected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "taskBundles": {
      "type": "object",
      "additionalProperties": true
    },
    "editMode": { "$ref": "#/$defs/editMode" },
    "upstreams": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/upstream" }
    },
    "tools": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/builtInTool" },
          { "$ref": "#/$defs/passThroughTool" },
          { "$ref": "#/$defs/workflowTool" }
        ]
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxLogBytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "annotations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "readOnlyHint": { "type": "boolean" },
        "destructiveHint": { "type": "boolean" },
        "idempotentHint": { "type": "boolean" },
        "openWorldHint": { "type": "boolean" }
      }
    },
    "toolMeta": {
      "type": "object",
      "additionalProperties": true
    },
    "inputPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "require": { "type": "object", "additionalProperties": true },
        "deny": { "type": "object", "additionalProperties": true },
        "pathFields": { "type": "array", "items": { "type": "string" } },
        "protectedPathPolicy": { "enum": ["deny", "allow"] }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "limits": { "$ref": "#/$defs/limits" },
        "taskBundles": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "editMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["single", "batch"] },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredToolOutputBytes": { "type": "integer", "minimum": 1 },
            "maxToolOutputBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oauthMaxBodyBytes": { "type": "integer", "minimum": 1 },
            "mcpMaxBodyBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultMaxEntries": { "type": "integer", "minimum": 1 },
            "maxEntries": { "type": "integer", "minimum": 1 },
            "maxDepth": { "type": "integer", "minimum": 0 }
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": { "enum": ["rg", "js"] },
            "defaultMaxResults": { "type": "integer", "minimum": 1 },
            "maxResults": { "type": "integer", "minimum": 1 },
            "maxColumns": { "type": "integer", "minimum": 1 },
            "maxContextLines": { "type": "integer", "minimum": 0 },
            "maxScannedBytesPerFile": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "null" }
              ]
            }
          }
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultMaxBytes": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "maxReadManyFiles": { "type": "integer", "minimum": 1 }
          }
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1 },
            "defaultMaxFiles": { "type": "integer", "minimum": 1 },
            "maxTotalBytes": { "type": "integer", "minimum": 1 },
            "maxTextFileBytes": { "type": "integer", "minimum": 1 },
            "maxInlineDiffBytes": { "type": "integer", "minimum": 1 },
            "maxInlineDiffLines": { "type": "integer", "minimum": 1 }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "maxTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "outputHeadBytes": { "type": "integer", "minimum": 1 },
            "outputTailBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "manual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttlSeconds": { "type": "integer", "minimum": 1 },
            "manualMessageMaxBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "rate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxCallsPerMinute": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["executable"],
      "additionalProperties": true,
      "properties": {
        "executable": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "defaultTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "maxTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "failOnStdout": { "type": "boolean" },
        "requiredPackageScript": { "type": "string" },
        "requiredFiles": { "type": "array", "items": { "type": "string" } },
        "allowExtraArgs": { "type": "boolean" },
        "maxExtraArgs": { "type": "integer", "minimum": 1 },
        "extraArgPattern": { "type": "string" },
        "allowedExtraArgs": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "upstream": {
      "type": "object",
      "required": ["transport"],
      "additionalProperties": true,
      "properties": {
        "transport": { "enum": ["stdio", "streamable-http", "local-task-runner"] },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "cwd": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "optional": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "tasks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/task" } }
      }
    },
    "builtInTool": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "builtIn" },
        "description": { "type": "string" },
        "inputSchema": { "$ref": "#/$defs/jsonSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" },
        "annotations": { "$ref": "#/$defs/annotations" },
        "_meta": { "$ref": "#/$defs/toolMeta" }
      }
    },
    "passThroughTool": {
      "type": "object",
      "required": ["name", "type", "upstream", "upstreamTool"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "passThrough" },
        "upstream": { "type": "string" },
        "upstreamTool": { "type": "string" },
        "optional": { "type": "boolean" },
        "description": { "type": "string" },
        "inputSchema": { "$ref": "#/$defs/jsonSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" },
        "annotations": { "$ref": "#/$defs/annotations" },
        "_meta": { "$ref": "#/$defs/toolMeta" },
        "inputPolicy": { "$ref": "#/$defs/inputPolicy" },
        "mapInput": true,
        "mapOutput": true
      }
    },
    "workflowTool": {
      "type": "object",
      "required": ["name", "type", "description", "inputSchema", "steps"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "workflow" },
        "optional": { "type": "boolean" },
        "description": { "type": "string" },
        "inputSchema": { "$ref": "#/$defs/jsonSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" },
        "annotations": { "$ref": "#/$defs/annotations" },
        "_meta": { "$ref": "#/$defs/toolMeta" },
        "timeoutSeconds": {
          "type": "object",
          "additionalProperties": true,
          "required": ["default", "maximum"],
          "properties": {
            "default": { "type": "integer", "minimum": 1 },
            "maximum": { "type": "integer", "minimum": 1 },
            "bufferSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["call"],
            "additionalProperties": true,
            "properties": {
              "call": {
                "type": "object",
                "required": ["upstream", "tool", "input"],
                "properties": {
                  "upstream": { "type": "string" },
                  "tool": { "type": "string" },
                  "input": true
                }
              },
              "saveAs": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
