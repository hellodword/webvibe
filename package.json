{
  "name": "webvibe",
  "version": "0.1.0",
  "description": "Policy-driven MCP relay for ChatGPT Web.",
  "type": "module",
  "bin": {
    "webvibe": "dist/main.js"
  },
  "files": [
    "dist",
    "policies",
    "config.example.yaml",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "policy:schema": "node scripts/generate-policy-schema.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "execa": "^9.6.1",
    "fast-json-stable-stringify": "^2.1.0",
    "minimatch": "^10.2.5",
    "nanoid": "^5.1.11",
    "pino": "^10.3.1",
    "toml": "^4.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
